# this file is base skeleton for .env
# .env is git-ignored 

# ── vLLM / OpenAI-compatible server (HPC) ──────────────────────────────────
# Set these when using a local-* model in configs/demo.yaml
OPENAI_BASE_URL=http://<HPC_NODE_IP>:8000/v1
OPENAI_API_KEY=<shared-secret-from-team>

# ── Google Gemini ───────────────────────────────────────────────────────────
# Required when model starts with "gemini-"
GOOGLE_API_KEY=your-google-api-key-here

# ── OpenRouter ──────────────────────────────────────────────────────────────
# Used for evaluation LLM (RAGAS scoring + testset generation)
# Set ragas_model in configs/demo.yaml to any OpenRouter model ID
# e.g. openai/gpt-4o-mini, anthropic/claude-3-haiku, meta-llama/llama-3-70b
OPENROUTER_API_KEY=sk-or-...

# ── Anthropic Claude ────────────────────────────────────────────────────────
# Required when model starts with "claude-"
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── OpenAlex (paper ingestion, not LLM) ────────────────────────────────────
OPENALEX_EMAIL=your-email@example.com
