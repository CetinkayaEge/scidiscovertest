# this file is base skeleton for .env
# .env is git-ignored 

# ── vLLM / OpenAI-compatible server (HPC) ──────────────────────────────────
# Set these when using a local-* model in configs/demo.yaml
OPENAI_BASE_URL=http://<HPC_NODE_IP>:8000/v1
OPENAI_API_KEY=<shared-secret-from-team>

# ── Google Gemini ───────────────────────────────────────────────────────────
# Required when model starts with "gemini-"
GOOGLE_API_KEY=your-google-api-key-here

# ── Anthropic Claude ────────────────────────────────────────────────────────
# Required when model starts with "claude-"
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── OpenAlex (paper ingestion, not LLM) ────────────────────────────────────
OPENALEX_EMAIL=your-email@example.com
